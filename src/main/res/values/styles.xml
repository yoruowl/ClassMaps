<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base for the dotted Widget.CampusNav.* names below (AAPT treats the dots as inheritance). -->
    <style name="Widget.CampusNav" parent="" />
    <style name="Widget.CampusNav.TopBar">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/top_bar_min_height</item>
        <item name="android:paddingLeft">@dimen/bar_padding_h</item>
        <item name="android:paddingRight">@dimen/bar_padding_h</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@color/primary</item>
    </style>

    <style name="Widget.CampusNav.TopBarText">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Shared bottom bar (each screen fills it with its own actions) ===== -->
    <style name="Widget.CampusNav.BottomBar">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/bottom_bar_min_height</item>
        <item name="android:paddingLeft">@dimen/bar_padding_h</item>
        <item name="android:paddingRight">@dimen/bar_padding_h</item>
        <item name="android:paddingTop">@dimen/bar_padding_v</item>
        <item name="android:paddingBottom">@dimen/bar_padding_v</item>
        <item name="android:background">@color/bar_background</item>
        <item name="android:elevation">8dp</item>
    </style>

    <style name="Widget.CampusNav.ScreenTitle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.CampusNav.FieldLabel">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">@dimen/field_spacing</item>
    </style>

    <!-- Round icon buttons (map overlay + schedule button) -->
    <style name="Widget.CampusNav.MapButton">
        <item name="android:background">@drawable/bg_map_button</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:elevation">4dp</item>
    </style>

</resources>