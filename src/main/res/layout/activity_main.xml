<?xml version="1.0" encoding="utf-8"?>
<!-- Wireframe: "Main Screen" / "Main Screen (Post Hazard)" / "Accessible Select" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <edu.uwec.campusnav.ui.CampusMapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_report_hazard"
                style="@style/Widget.CampusNav.MapButton"
                android:layout_width="@dimen/map_button_size"
                android:layout_height="@dimen/map_button_size"
                android:contentDescription="@string/cd_report_hazard"
                android:src="@drawable/ic_warning"
                app:tint="@color/map_button_icon_tint" />

            <ImageButton
                android:id="@+id/btn_accessibility"
                style="@style/Widget.CampusNav.MapButton"
                android:layout_width="@dimen/map_button_size"
                android:layout_height="@dimen/map_button_size"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/cd_accessibility"
                android:src="@drawable/ic_accessible"
                app:tint="@color/map_button_icon_tint" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        style="@style/Widget.CampusNav.BottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_find_room"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/round_button_size"
            android:layout_weight="1"
            android:text="@string/action_find_room"
            android:textSize="16sp"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_search"
            app:iconGravity="end" />

        <ImageButton
            android:id="@+id/btn_schedule"
            style="@style/Widget.CampusNav.MapButton"
            android:layout_width="@dimen/round_button_size"
            android:layout_height="@dimen/round_button_size"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/cd_schedule"
            android:src="@drawable/ic_calendar"
            app:tint="@color/map_button_icon_tint" />
    </LinearLayout>

</LinearLayout>
