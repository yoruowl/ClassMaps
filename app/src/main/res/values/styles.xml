<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ClassMaps" parent="" />

    <style name="Widget.ClassMaps.TopBar">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/top_bar_min_height</item>
        <item name="android:paddingLeft">@dimen/bar_padding_h</item>
        <item name="android:paddingRight">@dimen/bar_padding_h</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@color/primary</item>
    </style>

    <style name="Widget.ClassMaps.TopBarText">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ClassMaps.BottomBar">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/bottom_bar_min_height</item>
        <item name="android:paddingLeft">@dimen/bar_padding_h</item>
        <item name="android:paddingRight">@dimen/bar_padding_h</item>
        <item name="android:paddingTop">@dimen/bar_padding_v</item>
        <item name="android:paddingBottom">@dimen/bar_padding_v</item>
        <item name="android:background">@color/bar_background</item>
        <item name="android:elevation">8dp</item>
    </style>

    <style name="Widget.ClassMaps.ScreenTitle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ClassMaps.MapButton">
        <item name="android:background">@drawable/bg_map_button</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="BaseSurveyText">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SurveyHeadingText" parent="BaseSurveyText">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SwitchSideLabel" parent="BaseSurveyText">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="StarButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:padding">0dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="HazardOptionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PrimaryActionButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SecondaryActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#3F51B5</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FormInput" parent="BaseSurveyText">
        <item name="android:textColorHint">#757575</item>
        <item name="android:backgroundTint">#3F51B5</item>
    </style>

    <style name="TimeBoxButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">#E0E0E0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DayCheckBox" parent="BaseSurveyText">
        <item name="android:buttonTint">#3F51B5</item>
    </style>
</resources>
